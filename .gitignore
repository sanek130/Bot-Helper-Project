```gitignore
# Dependencies
node_modules/

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Build outputs
dist/
build/
*.min.js
*.bundle.js

# Compression
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# System
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Testing
.mypy_cache/
.pytest_cache/

# Java/Gradle
target/
.gradle/

# Temporary files
*.tmp
*.temp
*.log
```