# Токен бота от @BotFather, формат 123456789:AA...
BOT_TOKEN=

# Ник бота без @
BOT_USERNAME=HomeWorkly_bot

# Строка подключения MongoDB Atlas
MONGO_URI=

# tgId модераторов через запятую
MODERATOR_IDS=369745517

# tgId создателей через запятую
CREATOR_IDS=5191412364

# Адрес сайта без завершающего /
SITE_URL=https://bot-helper-project-dl5d.onrender.com

# Ключ подписи токенов сайта, минимум 32 символа
JWT_SECRET=

# Публичный адрес для вебхука, обычно совпадает с SITE_URL.
# Пустое значение — бот работает через long polling (удобно локально).
WEBHOOK_URL=https://bot-helper-project-dl5d.onrender.com

# Секрет вебхука: латиница, цифры, _ и -, от 8 до 128 символов
WEBHOOK_SECRET=

# Срок хранения ДЗ в днях
CLEANUP_DAYS=14

# Часовой пояс
TZ=Europe/Moscow
