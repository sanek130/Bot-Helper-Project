# Telegram Bot Token (получить от @BotFather)
BOT_TOKEN=your_bot_token_here

# MongoDB Connection String (MongoDB Atlas или локальный)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/homework-bot?retryWrites=true&w=majority

# Порт для Express сервера (для Render не обязательно, они сами устанавливают PORT)
PORT=5000

# URL Web App (после деплоя)
WEBAPP_URL=https://your-app.onrender.com/app
