# Токен бота от @BotFather
BOT_TOKEN=123456789:AAE1234567890abcdef1234567890abcdef

# Ник бота без @ (для ссылок t.me/...)
BOT_USERNAME=classbot_bot

# Строка подключения MongoDB Atlas
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/classbot?retryWrites=true&w=majority

# tgId создателей через запятую (узнать у @userinfobot)
MODERATOR_IDS=111111111,222222222

# Адрес сайта, например https://classbot.onrender.com
SITE_URL=http://localhost:3000

# Публичный адрес сервиса для вебхука (обычно совпадает с SITE_URL).
# Если не задан — бот запускается без вебхука (удобно локально).
# WEBHOOK_URL=http://localhost:3000

# Случайная строка, часть пути вебхука: /tg/{WEBHOOK_SECRET}
WEBHOOK_SECRET=replace_with_random_string

# Ключ подписи токенов сайта (не короче 32 символов)
JWT_SECRET=replace_with_random_string_at_least_32_chars

# Вход через Google (необязательно). Client ID из Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (Web). В «Authorized JavaScript origins»
# укажи SITE_URL. Без этой переменной кнопка Google на сайте скрыта.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Срок хранения ДЗ в днях
CLEANUP_DAYS=14

# Часовой пояс
TZ=Europe/Moscow

# Порт (Render задаёт сам)
PORT=3000
