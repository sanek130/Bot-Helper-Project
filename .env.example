# Telegram Bot Token (получить от @BotFather)
BOT_TOKEN=your_bot_token_here

# Имя бота без @ (для ссылок t.me/...)
BOT_USERNAME=your_bot_username

# MongoDB Connection String (MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/classbot?retryWrites=true&w=majority

# ID создателей/модераторов через запятую
MODERATOR_IDS=5191412364,369745517

# Адрес сайта
SITE_URL=https://bot-helper-project-dl5d.onrender.com

# Публичный адрес для вебхука (обычно совпадает с SITE_URL)
WEBHOOK_URL=https://bot-helper-project-dl5d.onrender.com

# Секретная строка для пути вебхука (сгенерируйте случайную строку)
WEBHOOK_SECRET=your_random_secret_string_here

# Ключ для подписи JWT токенов (сгенерируйте случайную строку)
JWT_SECRET=your_jwt_secret_key_here

# Срок хранения ДЗ в днях
CLEANUP_DAYS=14

# Часовой пояс
TZ=Europe/Moscow

# Порт (для Render используйте 10000)
PORT=10000
